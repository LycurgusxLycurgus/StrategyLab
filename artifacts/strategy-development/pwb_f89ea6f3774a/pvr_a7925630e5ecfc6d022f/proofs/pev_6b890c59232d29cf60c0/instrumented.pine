//@version=5
indicator("SmartMoney-4 Visual Audit 15m v2", overlay=true, max_labels_count=300, max_lines_count=140, max_boxes_count=180)

// Clean-sheet implementation. Authority: the timestamped 15-minute strategy
// transcript, its mandatory frames, and the approved SmartMoney-4 contract.

const string GROUP_SETUP = "Setup"
const string GROUP_RISK = "Risk Calculator"
const string GROUP_HISTORY = "History"
const int PIVOT_LEN = 2
const int PROFILE_ROWS = 24
const int PROFILE_LOOKBACK_BARS = 200
const int SWEEP_LOOKBACK_BARS = 48
const int MAX_CAUSAL_FVGS = 8

fibChoice = input.string("75%", "Fibonacci entry", options=["71%", "75%"], group=GROUP_SETUP)
checklistMode = input.string("Core + POC", "Checklist", options=["Core", "Core + POC"], group=GROUP_SETUP)
qualityMode = input.string("Standard", "Setup quality", options=["Standard", "Perfect"], group=GROUP_SETUP)
riskBudgetInput = input.float(2000.0, "Risk budget", minval=0.0, step=50.0, group=GROUP_RISK)
quantityModeInput = input.string("Base asset", "Position unit", options=["Base asset", "Lots"], group=GROUP_RISK)
unitsPerLotInput = input.float(1.0, "Base units per lot", minval=0.00000001, step=0.1, group=GROUP_RISK)
historyCountInput = input.int(20, "Completed trades", minval=1, maxval=60, group=GROUP_HISTORY)

float fibPct = fibChoice == "71%" ? 0.71 : 0.75
bool includePoc = checklistMode == "Core + POC"
int requiredScore = qualityMode == "Perfect" ? 100 : includePoc ? 80 : 75
bool eventBar = barstate.isconfirmed
bool is15m = timeframe.isminutes and timeframe.multiplier == 15

if barstate.isfirst and not is15m
    runtime.error("SmartMoney-4 Clean must run on a 15-minute chart.")

color panelBg = color.rgb(20, 23, 28)
color panelAlt = color.rgb(30, 34, 40)
color panelText = color.rgb(232, 234, 238)
color panelMuted = color.rgb(151, 157, 166)
color gold = color.rgb(196, 174, 72)
color passColor = color.rgb(43, 168, 107)
color failColor = color.rgb(197, 73, 79)
color lineColor = color.rgb(178, 183, 190)
color profileColor = color.new(color.rgb(139, 146, 156), 72)
color imbalanceColor = color.new(color.rgb(128, 139, 151), 82)
color imbalancePassColor = color.new(color.rgb(196, 174, 72), 78)
color longColor = color.rgb(48, 178, 125)
color shortColor = color.rgb(214, 82, 88)

f_price(float value) =>
    na(value) ? "—" : str.tostring(value, format.mintick)

f_mark(bool value) =>
    value ? "✓" : "✕"

f_mark_color(bool value) =>
    value ? passColor : failColor

f_missing(bool htf, bool bos, bool sweep, bool imbalance, bool poc, bool withPoc) =>
    string result = ""
    result := not htf ? "HTF" : result
    result := not bos ? (str.length(result) > 0 ? result + ", BOS" : "BOS") : result
    result := not sweep ? (str.length(result) > 0 ? result + ", LQ" : "LQ") : result
    result := not imbalance ? (str.length(result) > 0 ? result + ", FVG" : "FVG") : result
    result := withPoc and not poc ? (str.length(result) > 0 ? result + ", POC" : "POC") : result
    str.length(result) == 0 ? "NONE" : result

f_delete_line(line object) =>
    if not na(object)
        line.delete(object)

f_delete_label(label object) =>
    if not na(object)
        label.delete(object)

f_delete_box(box object) =>
    if not na(object)
        box.delete(object)

// Previous-completed 4h context only. The range is deliberately checklist-only.
float htfHigh = request.security(syminfo.tickerid, "240", ta.highest(high, 20)[1], lookahead=barmerge.lookahead_on)
float htfLow = request.security(syminfo.tickerid, "240", ta.lowest(low, 20)[1], lookahead=barmerge.lookahead_on)
float htfMid = (htfHigh + htfLow) * 0.5

// One-minute data powers the custom frozen profile.
[oneHigh, oneLow, oneVolume] = request.security_lower_tf(syminfo.tickerid, "1", [high, low, volume])
var array<int> rollBar = array.new_int()
var array<float> rollHigh = array.new_float()
var array<float> rollLow = array.new_float()
var array<float> rollVolume = array.new_float()

if eventBar
    int intrabars = array.size(oneHigh)
    if intrabars > 0
        for i = 0 to intrabars - 1
            array.push(rollBar, bar_index)
            array.push(rollHigh, array.get(oneHigh, i))
            array.push(rollLow, array.get(oneLow, i))
            array.push(rollVolume, nz(array.get(oneVolume, i)))
    int cutoff = bar_index - PROFILE_LOOKBACK_BARS
    while array.size(rollBar) > 0
        if array.get(rollBar, 0) < cutoff
            array.shift(rollBar)
            array.shift(rollHigh)
            array.shift(rollLow)
            array.shift(rollVolume)
        else
            break

float pivotHigh = ta.pivothigh(high, PIVOT_LEN, PIVOT_LEN)
float pivotLow = ta.pivotlow(low, PIVOT_LEN, PIVOT_LEN)
var float activeHigh = na
var float activeLow = na
var int activeHighBar = na
var int activeLowBar = na
var bool highConsumed = false
var bool lowConsumed = false
var int lastPivotType = 0

var int buySweepBar = na
var int buySweepLevelBar = na
var float buySweepLevel = na
var float buySweepExtreme = na
var int sellSweepBar = na
var int sellSweepLevelBar = na
var float sellSweepLevel = na
var float sellSweepExtreme = na

// Rolling, still-open three-candle gaps. Detection precedes BOS so the
// displacement gap that creates the break is not discarded.
var array<int> openFvgDirection = array.new_int()
var array<float> openFvgBottom = array.new_float()
var array<float> openFvgTop = array.new_float()
var array<int> openFvgSourceBar = array.new_int()
var array<int> openFvgDetectBar = array.new_int()
var array<bool> openFvgValid = array.new_bool()

// Candidate displacement state: +1 bullish, -1 bearish, 0 none.
var int legDirection = 0
var int legBosBar = na
var int legBosLevelBar = na
var float legBosLevel = na
var int legStartBar = na
var float legStop = na
var bool legSweep = false
var int legSweepBar = na
var int legSweepLevelBar = na
var float legSweepLevel = na
var array<float> legFvgBottom = array.new_float()
var array<float> legFvgTop = array.new_float()
var array<int> legFvgBar = array.new_int()
var array<bool> legFvgValid = array.new_bool()

// Latest frozen candidate powers the visible checklist whether or not it passes.
var int candidateDirection = 0
var int candidateReadyBar = na
var int candidateStartBar = na
var int candidateEndBar = na
var float candidateLow = na
var float candidateHigh = na
var float candidateEntry = na
var float candidateStop = na
var float candidateTarget = na
var float candidatePoc = na
var bool candidateHtf = false
var bool candidateBos = false
var bool candidateSweep = false
var bool candidateImbalance = false
var bool candidatePocPass = false
var int candidateFvgCount = 0
var int candidateFvgPassCount = 0
var bool candidateBreakFvg = false
var int candidateScore = 0
var bool candidateLate = false
var bool candidateEligible = false
var string candidateMissing = "—"
var float candidateFvgBottom = na
var float candidateFvgTop = na
var int candidateFvgBar = na
var int candidateSweepBar = na
var int candidateSweepLevelBar = na
var float candidateSweepLevel = na
var int candidateBosBar = na
var int candidateBosLevelBar = na
var float candidateBosLevel = na
var array<float> candidateProfile = array.new_float(PROFILE_ROWS, 0.0)
var array<float> candidateFvgBottoms = array.new_float()
var array<float> candidateFvgTops = array.new_float()
var array<int> candidateFvgBars = array.new_int()
var array<bool> candidateFvgPasses = array.new_bool()

// Trade ledger. 0 pending, 1 filled, 2 TP, 3 SL, 4 missed/invalid, 5 ambiguous.
var array<int> setupDirection = array.new_int()
var array<int> setupReadyBar = array.new_int()
var array<int> setupState = array.new_int()
var array<float> setupEntry = array.new_float()
var array<float> setupStop = array.new_float()
var array<float> setupTarget = array.new_float()
var array<int> setupScore = array.new_int()
var array<string> setupMissing = array.new_string()
var array<label> setupEntryLabel = array.new_label()
var array<label> setupExitLabel = array.new_label()

bool bullBreakSignal = false
bool bearBreakSignal = false
bool setupReadySignal = false
bool candidateUpdatedSignal = false
bool longReadySignal = false
bool shortReadySignal = false
bool fillSignal = false
bool targetSignal = false
bool stopSignal = false
bool ambiguousSignal = false

if eventBar
    // Alternating structural pivots: same-side pivots may refine only by making
    // a more extreme swing. Ambiguous dual pivots advance one side only.
    bool confirmedHigh = not na(pivotHigh)
    bool confirmedLow = not na(pivotLow)
    bool acceptHigh = confirmedHigh and (not confirmedLow or lastPivotType <= 0)
    bool acceptLow = confirmedLow and (not confirmedHigh or lastPivotType > 0)
    bool pivotHighAccepted = false
    bool pivotLowAccepted = false
    if acceptHigh and (lastPivotType != 1 or na(activeHigh) or pivotHigh > activeHigh)
        int sourceBar = bar_index - PIVOT_LEN
        activeHigh := pivotHigh
        activeHighBar := sourceBar
        highConsumed := false
        if not na(buySweepBar) and sourceBar > buySweepBar
            buySweepBar := na
            buySweepLevelBar := na
            buySweepLevel := na
            buySweepExtreme := na
        lastPivotType := 1
        pivotHighAccepted := true
    if acceptLow and (lastPivotType != -1 or na(activeLow) or pivotLow < activeLow)
        int sourceBar = bar_index - PIVOT_LEN
        activeLow := pivotLow
        activeLowBar := sourceBar
        lowConsumed := false
        if not na(sellSweepBar) and sourceBar > sellSweepBar
            sellSweepBar := na
            sellSweepLevelBar := na
            sellSweepLevel := na
            sellSweepExtreme := na
        lastPivotType := -1
        pivotLowAccepted := true

    // Potential sweeps expire, are invalidated by acceptance beyond their
    // level, or are replaced by a newer sweep of the same owned swing.
    if not na(buySweepBar) and (bar_index - buySweepBar > SWEEP_LOOKBACK_BARS or close > buySweepLevel)
        buySweepBar := na
        buySweepLevelBar := na
        buySweepLevel := na
        buySweepExtreme := na
    if not na(sellSweepBar) and (bar_index - sellSweepBar > SWEEP_LOOKBACK_BARS or close < sellSweepLevel)
        sellSweepBar := na
        sellSweepLevelBar := na
        sellSweepLevel := na
        sellSweepExtreme := na

    bool buySweepNow = not na(activeHigh) and not highConsumed and high > activeHigh and close <= activeHigh
    bool sellSweepNow = not na(activeLow) and not lowConsumed and low < activeLow and close >= activeLow
    if buySweepNow and not sellSweepNow
        buySweepBar := bar_index
        buySweepLevelBar := activeHighBar
        buySweepLevel := activeHigh
        buySweepExtreme := high
    if sellSweepNow and not buySweepNow
        sellSweepBar := bar_index
        sellSweepLevelBar := activeLowBar
        sellSweepLevel := activeLow
        sellSweepExtreme := low

    // Age and invalidate open gaps before detecting the current bar's gap.
    if array.size(openFvgValid) > 0
        for i = 0 to array.size(openFvgValid) - 1
            if array.get(openFvgValid, i) and bar_index > array.get(openFvgDetectBar, i)
                int fvgDirection = array.get(openFvgDirection, i)
                float fvgBottom = array.get(openFvgBottom, i)
                float fvgTop = array.get(openFvgTop, i)
                bool mitigated = fvgDirection == 1 ? low <= fvgBottom : high >= fvgTop
                if mitigated
                    array.set(openFvgValid, i, false)
    if array.size(legFvgValid) > 0
        for i = 0 to array.size(legFvgValid) - 1
            if array.get(legFvgValid, i)
                int fvgSource = array.get(legFvgBar, i)
                float fvgBottom = array.get(legFvgBottom, i)
                float fvgTop = array.get(legFvgTop, i)
                bool mitigated = bar_index > fvgSource + 2 and (legDirection == 1 ? low <= fvgBottom : high >= fvgTop)
                if mitigated
                    array.set(legFvgValid, i, false)

    bool bullFvgNow = low > high[2]
    bool bearFvgNow = high < low[2]
    if bullFvgNow or bearFvgNow
        int fvgDirection = bullFvgNow ? 1 : -1
        float fvgBottom = bullFvgNow ? high[2] : high
        float fvgTop = bullFvgNow ? low : low[2]
        array.push(openFvgDirection, fvgDirection)
        array.push(openFvgBottom, fvgBottom)
        array.push(openFvgTop, fvgTop)
        array.push(openFvgSourceBar, bar_index - 2)
        array.push(openFvgDetectBar, bar_index)
        array.push(openFvgValid, true)
        if legDirection == fvgDirection and bar_index > legBosBar
            array.push(legFvgBottom, fvgBottom)
            array.push(legFvgTop, fvgTop)
            array.push(legFvgBar, bar_index - 2)
            array.push(legFvgValid, true)
    while array.size(openFvgDirection) > 96
        array.shift(openFvgDirection)
        array.shift(openFvgBottom)
        array.shift(openFvgTop)
        array.shift(openFvgSourceBar)
        array.shift(openFvgDetectBar)
        array.shift(openFvgValid)

    bullBreakSignal := not na(activeHigh) and not highConsumed and close > activeHigh
    bearBreakSignal := not na(activeLow) and not lowConsumed and close < activeLow

    if bullBreakSignal and not bearBreakSignal
        bool linkedSweep = not na(sellSweepBar) and sellSweepBar < bar_index and bar_index - sellSweepBar <= SWEEP_LOOKBACK_BARS
        legDirection := 1
        legBosBar := bar_index
        legBosLevelBar := activeHighBar
        legBosLevel := activeHigh
        legSweep := linkedSweep
        legSweepBar := linkedSweep ? sellSweepBar : na
        legSweepLevelBar := linkedSweep ? sellSweepLevelBar : na
        legSweepLevel := linkedSweep ? sellSweepLevel : na
        legStartBar := linkedSweep ? sellSweepBar : activeLowBar
        legStop := linkedSweep ? sellSweepExtreme : activeLow
        array.clear(legFvgBottom)
        array.clear(legFvgTop)
        array.clear(legFvgBar)
        array.clear(legFvgValid)
        if not na(legStartBar) and array.size(openFvgDirection) > 0
            for i = 0 to array.size(openFvgDirection) - 1
                bool causal = array.get(openFvgDirection, i) == 1 and array.get(openFvgValid, i) and array.get(openFvgDetectBar, i) >= legStartBar and array.get(openFvgDetectBar, i) <= bar_index
                if causal
                    array.push(legFvgBottom, array.get(openFvgBottom, i))
                    array.push(legFvgTop, array.get(openFvgTop, i))
                    array.push(legFvgBar, array.get(openFvgSourceBar, i))
                    array.push(legFvgValid, true)
        highConsumed := true
        if linkedSweep
            sellSweepBar := na
            sellSweepLevelBar := na
            sellSweepLevel := na
            sellSweepExtreme := na
    else if bearBreakSignal and not bullBreakSignal
        bool linkedSweep = not na(buySweepBar) and buySweepBar < bar_index and bar_index - buySweepBar <= SWEEP_LOOKBACK_BARS
        legDirection := -1
        legBosBar := bar_index
        legBosLevelBar := activeLowBar
        legBosLevel := activeLow
        legSweep := linkedSweep
        legSweepBar := linkedSweep ? buySweepBar : na
        legSweepLevelBar := linkedSweep ? buySweepLevelBar : na
        legSweepLevel := linkedSweep ? buySweepLevel : na
        legStartBar := linkedSweep ? buySweepBar : activeHighBar
        legStop := linkedSweep ? buySweepExtreme : activeHigh
        array.clear(legFvgBottom)
        array.clear(legFvgTop)
        array.clear(legFvgBar)
        array.clear(legFvgValid)
        if not na(legStartBar) and array.size(openFvgDirection) > 0
            for i = 0 to array.size(openFvgDirection) - 1
                bool causal = array.get(openFvgDirection, i) == -1 and array.get(openFvgValid, i) and array.get(openFvgDetectBar, i) >= legStartBar and array.get(openFvgDetectBar, i) <= bar_index
                if causal
                    array.push(legFvgBottom, array.get(openFvgBottom, i))
                    array.push(legFvgTop, array.get(openFvgTop, i))
                    array.push(legFvgBar, array.get(openFvgSourceBar, i))
                    array.push(legFvgValid, true)
        lowConsumed := true
        if linkedSweep
            buySweepBar := na
            buySweepLevelBar := na
            buySweepLevel := na
            buySweepExtreme := na

    bool lockLong = legDirection == 1 and pivotHighAccepted and bar_index - PIVOT_LEN > legBosBar
    bool lockShort = legDirection == -1 and pivotLowAccepted and bar_index - PIVOT_LEN > legBosBar
    if lockLong or lockShort
        int direction = lockLong ? 1 : -1
        int endpointBar = bar_index - PIVOT_LEN
        float endpoint = lockLong ? pivotHigh : pivotLow
        float rangeLow = direction == 1 ? legStop : endpoint
        float rangeHigh = direction == 1 ? endpoint : legStop
        bool geometryValid = not na(rangeLow) and not na(rangeHigh) and rangeHigh > rangeLow and not na(legStartBar)
        if geometryValid
            float rangeSize = rangeHigh - rangeLow
            float entryPrice = direction == 1 ? rangeHigh - fibPct * rangeSize : rangeLow + fibPct * rangeSize
            float stopPrice = direction == 1 ? rangeLow : rangeHigh
            float targetPrice = direction == 1 ? rangeHigh : rangeLow

            bool imbalancePass = false
            int fvgPassCount = 0
            bool breakFvgPresent = false
            float chosenFvgBottom = na
            float chosenFvgTop = na
            int chosenFvgBar = na
            array.clear(candidateFvgBottoms)
            array.clear(candidateFvgTops)
            array.clear(candidateFvgBars)
            array.clear(candidateFvgPasses)
            if array.size(legFvgBottom) > 0
                for i = 0 to array.size(legFvgBottom) - 1
                    float fvgBottom = array.get(legFvgBottom, i)
                    float fvgTop = array.get(legFvgTop, i)
                    bool fvgValid = array.get(legFvgValid, i)
                    bool fvgPass = fvgValid and entryPrice >= fvgBottom and entryPrice <= fvgTop
                    if fvgValid
                        breakFvgPresent := breakFvgPresent or array.get(legFvgBar, i) + 2 <= legBosBar
                        if array.size(candidateFvgBottoms) >= MAX_CAUSAL_FVGS
                            array.shift(candidateFvgBottoms)
                            array.shift(candidateFvgTops)
                            array.shift(candidateFvgBars)
                            array.shift(candidateFvgPasses)
                        array.push(candidateFvgBottoms, fvgBottom)
                        array.push(candidateFvgTops, fvgTop)
                        array.push(candidateFvgBars, array.get(legFvgBar, i))
                        array.push(candidateFvgPasses, fvgPass)
                    if fvgPass
                        imbalancePass := true
                        fvgPassCount += 1
                        chosenFvgBottom := fvgBottom
                        chosenFvgTop := fvgTop
                        chosenFvgBar := array.get(legFvgBar, i)

            array.clear(candidateProfile)
            for row = 0 to PROFILE_ROWS - 1
                array.push(candidateProfile, 0.0)
            float rowHeight = rangeSize / PROFILE_ROWS
            if array.size(rollBar) > 0
                for i = 0 to array.size(rollBar) - 1
                    int sourceBar = array.get(rollBar, i)
                    if sourceBar >= legStartBar and sourceBar <= endpointBar
                        float intrabarHigh = math.min(array.get(rollHigh, i), rangeHigh)
                        float intrabarLow = math.max(array.get(rollLow, i), rangeLow)
                        float intrabarVolume = array.get(rollVolume, i)
                        if intrabarHigh >= intrabarLow and intrabarVolume > 0
                            int firstRow = int(math.floor((intrabarLow - rangeLow) / rowHeight))
                            int lastRow = int(math.floor((intrabarHigh - rangeLow) / rowHeight))
                            firstRow := math.max(0, math.min(PROFILE_ROWS - 1, firstRow))
                            lastRow := math.max(0, math.min(PROFILE_ROWS - 1, lastRow))
                            int touchedRows = math.max(1, lastRow - firstRow + 1)
                            float share = intrabarVolume / touchedRows
                            for row = firstRow to lastRow
                                array.set(candidateProfile, row, array.get(candidateProfile, row) + share)

            float maxVolume = 0.0
            int pocRow = 0
            for row = 0 to PROFILE_ROWS - 1
                float rowVolume = array.get(candidateProfile, row)
                if rowVolume > maxVolume
                    maxVolume := rowVolume
                    pocRow := row
            float pocPrice = rangeLow + (pocRow + 0.5) * rowHeight
            bool pocPass = maxVolume > 0 and math.abs(pocPrice - entryPrice) <= math.max(2.0 * rowHeight, 0.05 * rangeSize)
            bool htfPass = direction == 1 ? close <= htfMid : close >= htfMid
            bool bosPass = not na(legBosBar) and not na(legBosLevelBar) and not na(legBosLevel)
            int passed = (htfPass ? 1 : 0) + (bosPass ? 1 : 0) + (legSweep ? 1 : 0) + (imbalancePass ? 1 : 0) + (includePoc and pocPass ? 1 : 0)
            int score = includePoc ? passed * 20 : passed * 25
            bool late = false
            for offset = 0 to PIVOT_LEN - 1
                late := late or (direction == 1 ? low[offset] <= entryPrice : high[offset] >= entryPrice)
            bool eligible = score >= requiredScore and not late

            candidateDirection := direction
            candidateReadyBar := bar_index
            candidateStartBar := legStartBar
            candidateEndBar := endpointBar
            candidateLow := rangeLow
            candidateHigh := rangeHigh
            candidateEntry := entryPrice
            candidateStop := stopPrice
            candidateTarget := targetPrice
            candidatePoc := pocPrice
            candidateHtf := htfPass
            candidateBos := bosPass
            candidateSweep := legSweep
            candidateImbalance := imbalancePass
            candidatePocPass := pocPass
            candidateFvgCount := array.size(candidateFvgBottoms)
            candidateFvgPassCount := fvgPassCount
            candidateBreakFvg := breakFvgPresent
            candidateScore := score
            candidateLate := late
            candidateEligible := eligible
            candidateMissing := f_missing(htfPass, bosPass, legSweep, imbalancePass, pocPass, includePoc)
            candidateFvgBottom := chosenFvgBottom
            candidateFvgTop := chosenFvgTop
            candidateFvgBar := chosenFvgBar
            candidateSweepBar := legSweepBar
            candidateSweepLevelBar := legSweepLevelBar
            candidateSweepLevel := legSweepLevel
            candidateBosBar := legBosBar
            candidateBosLevelBar := legBosLevelBar
            candidateBosLevel := legBosLevel
            candidateUpdatedSignal := true

            if eligible
                array.push(setupDirection, direction)
                array.push(setupReadyBar, bar_index)
                array.push(setupState, 0)
                array.push(setupEntry, entryPrice)
                array.push(setupStop, stopPrice)
                array.push(setupTarget, targetPrice)
                array.push(setupScore, score)
                array.push(setupMissing, candidateMissing)
                array.push(setupEntryLabel, na)
                array.push(setupExitLabel, na)
                setupReadySignal := true
                longReadySignal := direction == 1
                shortReadySignal := direction == -1
        legDirection := 0
        array.clear(legFvgBottom)
        array.clear(legFvgTop)
        array.clear(legFvgBar)
        array.clear(legFvgValid)

    // Independent lifecycle evaluation for every emitted setup.
    if array.size(setupState) > 0
        for i = 0 to array.size(setupState) - 1
            int state = array.get(setupState, i)
            int readyBar = array.get(setupReadyBar, i)
            if bar_index > readyBar and state <= 1
                int direction = array.get(setupDirection, i)
                float entryPrice = array.get(setupEntry, i)
                float stopPrice = array.get(setupStop, i)
                float targetPrice = array.get(setupTarget, i)
                bool entryTouched = direction == 1 ? low <= entryPrice : high >= entryPrice
                bool stopTouched = direction == 1 ? low <= stopPrice : high >= stopPrice
                bool targetTouched = direction == 1 ? high >= targetPrice : low <= targetPrice
                if state == 0
                    if entryTouched
                        string entryText = (direction == 1 ? "LONG " : "SHORT ") + str.tostring(array.get(setupScore, i))
                        string missing = array.get(setupMissing, i)
                        entryText += missing == "NONE" ? "" : "\nMISS " + missing
                        label openLabel = label.new(bar_index, entryPrice, entryText, xloc=xloc.bar_index, style=direction == 1 ? label.style_label_up : label.style_label_down, color=direction == 1 ? longColor : shortColor, textcolor=color.white, size=size.tiny)
                        array.set(setupEntryLabel, i, openLabel)
                        fillSignal := true
                        if stopTouched or targetTouched
                            label exitLabel = label.new(bar_index, stopTouched ? stopPrice : targetPrice, "AMBIG", xloc=xloc.bar_index, style=label.style_label_left, color=color.rgb(111, 83, 143), textcolor=color.white, size=size.tiny)
                            array.set(setupExitLabel, i, exitLabel)
                            array.set(setupState, i, 5)
                            ambiguousSignal := true
                        else
                            array.set(setupState, i, 1)
                    else if stopTouched or targetTouched
                        array.set(setupState, i, 4)
                else if state == 1
                    if stopTouched and targetTouched
                        label exitLabel = label.new(bar_index, close, "AMBIG", xloc=xloc.bar_index, style=label.style_label_left, color=color.rgb(111, 83, 143), textcolor=color.white, size=size.tiny)
                        array.set(setupExitLabel, i, exitLabel)
                        array.set(setupState, i, 5)
                        ambiguousSignal := true
                    else if targetTouched
                        float rr = math.abs(targetPrice - entryPrice) / math.abs(entryPrice - stopPrice)
                        label exitLabel = label.new(bar_index, targetPrice, "TP +" + str.tostring(rr, "#.##") + "R", xloc=xloc.bar_index, style=direction == 1 ? label.style_label_down : label.style_label_up, color=longColor, textcolor=color.white, size=size.tiny)
                        array.set(setupExitLabel, i, exitLabel)
                        array.set(setupState, i, 2)
                        targetSignal := true
                    else if stopTouched
                        label exitLabel = label.new(bar_index, stopPrice, "SL -1R", xloc=xloc.bar_index, style=direction == 1 ? label.style_label_up : label.style_label_down, color=shortColor, textcolor=color.white, size=size.tiny)
                        array.set(setupExitLabel, i, exitLabel)
                        array.set(setupState, i, 3)
                        stopSignal := true

    // Bound historical trade labels without mutating the strategy ledger.
    int labelledTrades = 0
    if array.size(setupState) > 0
        for reverse = 0 to array.size(setupState) - 1
            int i = array.size(setupState) - 1 - reverse
            if not na(array.get(setupEntryLabel, i))
                labelledTrades += 1
                if labelledTrades > historyCountInput
                    f_delete_label(array.get(setupEntryLabel, i))
                    f_delete_label(array.get(setupExitLabel, i))
                    array.set(setupEntryLabel, i, na)
                    array.set(setupExitLabel, i, na)

// The latest locked structural narrative is always visible. Only position
// geometry depends on eligibility; completed trades never erase the audit.
var line rangeHighLine = na
var line rangeLowLine = na
var line entryLine = na
var line pocLine = na
var line lqLine = na
var line bosLine = na
var label rangeHighLabel = na
var label rangeLowLabel = na
var label entryLevelLabel = na
var label pocLevelLabel = na
var label lqLabel = na
var label bosLabel = na
var box rewardBox = na
var box riskBox = na
var array<box> profileBoxes = array.new_box()
var array<box> fvgBoxes = array.new_box()

if candidateUpdatedSignal
    f_delete_line(rangeHighLine)
    f_delete_line(rangeLowLine)
    f_delete_line(entryLine)
    f_delete_line(pocLine)
    f_delete_line(lqLine)
    f_delete_line(bosLine)
    f_delete_label(rangeHighLabel)
    f_delete_label(rangeLowLabel)
    f_delete_label(entryLevelLabel)
    f_delete_label(pocLevelLabel)
    f_delete_label(lqLabel)
    f_delete_label(bosLabel)
    f_delete_box(rewardBox)
    f_delete_box(riskBox)
    if array.size(profileBoxes) > 0
        for i = 0 to array.size(profileBoxes) - 1
            box.delete(array.get(profileBoxes, i))
    array.clear(profileBoxes)
    if array.size(fvgBoxes) > 0
        for i = 0 to array.size(fvgBoxes) - 1
            box.delete(array.get(fvgBoxes, i))
    array.clear(fvgBoxes)
    rangeHighLine := na
    rangeLowLine := na
    entryLine := na
    pocLine := na
    lqLine := na
    bosLine := na
    rangeHighLabel := na
    rangeLowLabel := na
    entryLevelLabel := na
    pocLevelLabel := na
    lqLabel := na
    bosLabel := na
    rewardBox := na
    riskBox := na

if not na(candidateReadyBar)
    int visualRight = bar_index + 15
    if na(rangeHighLine)
        rangeHighLine := line.new(candidateStartBar, candidateHigh, visualRight, candidateHigh, xloc=xloc.bar_index, color=lineColor, width=1)
        rangeLowLine := line.new(candidateStartBar, candidateLow, visualRight, candidateLow, xloc=xloc.bar_index, color=lineColor, width=1)
        entryLine := line.new(candidateStartBar, candidateEntry, visualRight, candidateEntry, xloc=xloc.bar_index, color=gold, width=2)
        pocLine := line.new(candidateStartBar, candidatePoc, visualRight, candidatePoc, xloc=xloc.bar_index, color=color.new(panelText, 20), style=line.style_dashed, width=1)
        string highText = candidateDirection == 1 ? "0" : "1"
        string lowText = candidateDirection == 1 ? "1" : "0"
        rangeHighLabel := label.new(visualRight, candidateHigh, highText, xloc=xloc.bar_index, style=label.style_none, textcolor=panelMuted, size=size.tiny)
        rangeLowLabel := label.new(visualRight, candidateLow, lowText, xloc=xloc.bar_index, style=label.style_none, textcolor=panelMuted, size=size.tiny)
        entryLevelLabel := label.new(visualRight, candidateEntry, fibChoice, xloc=xloc.bar_index, style=label.style_none, textcolor=gold, size=size.tiny)
        pocLevelLabel := label.new(visualRight, candidatePoc, "POC est.", xloc=xloc.bar_index, style=label.style_none, textcolor=panelMuted, size=size.tiny)
        if candidateSweep and not na(candidateSweepLevelBar)
            lqLine := line.new(candidateSweepLevelBar, candidateSweepLevel, candidateSweepBar, candidateSweepLevel, xloc=xloc.bar_index, color=lineColor, width=1)
            lqLabel := label.new(candidateSweepBar, candidateSweepLevel, "LQ", xloc=xloc.bar_index, style=label.style_none, textcolor=panelText, size=size.tiny, textalign=text.align_center)
        bosLine := line.new(candidateBosLevelBar, candidateBosLevel, candidateBosBar, candidateBosLevel, xloc=xloc.bar_index, color=lineColor, width=1)
        bosLabel := label.new(candidateBosBar, candidateBosLevel, "BOS", xloc=xloc.bar_index, style=label.style_none, textcolor=panelText, size=size.tiny, textalign=text.align_center)
        if array.size(candidateFvgBottoms) > 0
            for i = 0 to array.size(candidateFvgBottoms) - 1
                int fvgBar = array.get(candidateFvgBars, i)
                bool fvgPass = array.get(candidateFvgPasses, i)
                box fvgObject = box.new(fvgBar, array.get(candidateFvgTops, i), math.min(fvgBar + 4, visualRight), array.get(candidateFvgBottoms, i), xloc=xloc.bar_index, bgcolor=fvgPass ? imbalancePassColor : imbalanceColor, border_color=fvgPass ? color.new(gold, 35) : color.new(lineColor, 70))
                array.push(fvgBoxes, fvgObject)
        if candidateEligible
            rewardBox := box.new(candidateReadyBar, math.max(candidateEntry, candidateTarget), visualRight, math.min(candidateEntry, candidateTarget), xloc=xloc.bar_index, bgcolor=color.new(longColor, 88), border_color=color.new(longColor, 60))
            riskBox := box.new(candidateReadyBar, math.max(candidateEntry, candidateStop), visualRight, math.min(candidateEntry, candidateStop), xloc=xloc.bar_index, bgcolor=color.new(shortColor, 88), border_color=color.new(shortColor, 60))
        float maxProfile = array.max(candidateProfile)
        float rowHeight = (candidateHigh - candidateLow) / PROFILE_ROWS
        for row = 0 to PROFILE_ROWS - 1
            float rowVolume = array.get(candidateProfile, row)
            int widthBars = maxProfile > 0 ? int(math.round(12.0 * rowVolume / maxProfile)) : 0
            float rowBottom = candidateLow + row * rowHeight
            float rowTop = rowBottom + rowHeight
            box profileBox = box.new(visualRight - widthBars, rowTop, visualRight, rowBottom, xloc=xloc.bar_index, bgcolor=profileColor, border_color=color.new(profileColor, 100))
            array.push(profileBoxes, profileBox)
    else
        line.set_x2(rangeHighLine, visualRight)
        line.set_x2(rangeLowLine, visualRight)
        line.set_x2(entryLine, visualRight)
        line.set_x2(pocLine, visualRight)
        label.set_x(rangeHighLabel, visualRight)
        label.set_x(rangeLowLabel, visualRight)
        label.set_x(entryLevelLabel, visualRight)
        label.set_x(pocLevelLabel, visualRight)
        if not na(rewardBox)
            box.set_right(rewardBox, visualRight)
        if not na(riskBox)
            box.set_right(riskBox, visualRight)
        if array.size(profileBoxes) == PROFILE_ROWS
            float maxProfile = array.max(candidateProfile)
            for row = 0 to PROFILE_ROWS - 1
                float rowVolume = array.get(candidateProfile, row)
                int widthBars = maxProfile > 0 ? int(math.round(12.0 * rowVolume / maxProfile)) : 0
                box.set_left(array.get(profileBoxes, row), visualRight - widthBars)
                box.set_right(array.get(profileBoxes, row), visualRight)

// A terminal setup collapses only its position geometry. LQ/BOS/FVG/Fib/POC
// remain visible until a newer locked narrative supersedes them.
if array.size(setupState) > 0
    int newest = array.size(setupState) - 1
    int newestState = array.get(setupState, newest)
    if newestState >= 2
        f_delete_box(rewardBox)
        f_delete_box(riskBox)
        rewardBox := na
        riskBox := na

var table checklist = table.new(position.top_right, 2, 9, bgcolor=panelBg, frame_color=gold, frame_width=1, border_color=color.new(gold, 30), border_width=1)
var table riskTable = table.new(position.bottom_right, 2, 4, bgcolor=panelBg, frame_color=gold, frame_width=1, border_color=color.new(gold, 30), border_width=1)

if barstate.islast
    string directionText = candidateDirection == 1 ? "BUY" : candidateDirection == -1 ? "SELL" : "—"
    string locationText = na(htfMid) ? "—" : close <= htfMid ? "Discount" : "Premium"
    table.cell(checklist, 0, 0, "4H", bgcolor=panelBg, text_color=panelMuted, text_size=size.small)
    table.cell(checklist, 1, 0, locationText, bgcolor=panelAlt, text_color=panelText, text_size=size.small)
    table.cell(checklist, 0, 1, directionText, bgcolor=panelBg, text_color=candidateDirection == 1 ? longColor : candidateDirection == -1 ? shortColor : panelMuted, text_size=size.small)
    table.cell(checklist, 1, 1, "Checklist", bgcolor=panelBg, text_color=panelText, text_size=size.small)
    table.cell(checklist, 0, 2, f_mark(candidateHtf), bgcolor=panelBg, text_color=f_mark_color(candidateHtf), text_size=size.small)
    table.cell(checklist, 1, 2, "HTF Alignment", bgcolor=panelBg, text_color=panelText, text_size=size.small)
    table.cell(checklist, 0, 3, f_mark(candidateBos), bgcolor=panelAlt, text_color=f_mark_color(candidateBos), text_size=size.small)
    table.cell(checklist, 1, 3, "Break of Structure", bgcolor=panelAlt, text_color=panelText, text_size=size.small)
    table.cell(checklist, 0, 4, f_mark(candidateSweep), bgcolor=panelBg, text_color=f_mark_color(candidateSweep), text_size=size.small)
    table.cell(checklist, 1, 4, "Liquidity Sweep", bgcolor=panelBg, text_color=panelText, text_size=size.small)
    table.cell(checklist, 0, 5, f_mark(candidateImbalance), bgcolor=panelAlt, text_color=f_mark_color(candidateImbalance), text_size=size.small)
    table.cell(checklist, 1, 5, "Imbalance", bgcolor=panelAlt, text_color=panelText, text_size=size.small)
    table.cell(checklist, 0, 6, includePoc ? f_mark(candidatePocPass) : "—", bgcolor=panelBg, text_color=includePoc ? f_mark_color(candidatePocPass) : panelMuted, text_size=size.small)
    table.cell(checklist, 1, 6, includePoc ? "POC near Fib" : "POC disabled", bgcolor=panelBg, text_color=panelText, text_size=size.small)
    table.cell(checklist, 0, 7, str.tostring(candidateScore), bgcolor=panelAlt, text_color=candidateScore >= requiredScore ? passColor : failColor, text_size=size.small)
    table.cell(checklist, 1, 7, "Score / " + str.tostring(requiredScore), bgcolor=panelAlt, text_color=panelText, text_size=size.small)
    string statusText = candidateLate ? "LATE" : candidateEligible ? "READY" : "WAIT"
    table.cell(checklist, 0, 8, statusText, bgcolor=panelBg, text_color=candidateEligible ? passColor : candidateLate ? failColor : panelMuted, text_size=size.tiny)
    table.cell(checklist, 1, 8, candidateMissing == "NONE" ? "All passed" : "Miss: " + candidateMissing, bgcolor=panelBg, text_color=panelMuted, text_size=size.tiny)

    float stopDistance = math.abs(candidateEntry - candidateStop)
    float baseQuantity = stopDistance > 0 ? riskBudgetInput / stopDistance : na
    float quantity = quantityModeInput == "Lots" and not na(baseQuantity) ? baseQuantity / unitsPerLotInput : baseQuantity
    float stopPercent = not na(candidateEntry) and candidateEntry != 0 ? 100.0 * stopDistance / candidateEntry : na
    string baseAsset = syminfo.basecurrency == "" ? "Units" : syminfo.basecurrency
    string quantityUnit = quantityModeInput == "Lots" ? "Lots" : baseAsset
    string quoteAsset = syminfo.currency == "" ? "Price" : syminfo.currency
    table.cell(riskTable, 0, 0, quantityModeInput == "Lots" ? "Auto Lot" : "Auto Risk", bgcolor=panelBg, text_color=panelText, text_size=size.small)
    table.cell(riskTable, 1, 0, fibChoice, bgcolor=panelAlt, text_color=gold, text_size=size.small)
    table.cell(riskTable, 0, 1, na(quantity) ? "—" : str.tostring(quantity, "#.####"), bgcolor=panelAlt, text_color=panelText, text_size=size.small)
    table.cell(riskTable, 1, 1, quantityUnit, bgcolor=panelAlt, text_color=panelMuted, text_size=size.small)
    table.cell(riskTable, 0, 2, na(stopPercent) ? "—" : f_price(stopDistance) + " · " + str.tostring(stopPercent, "#.##") + "%", bgcolor=panelBg, text_color=panelText, text_size=size.small)
    table.cell(riskTable, 1, 2, quoteAsset + " Stop", bgcolor=panelBg, text_color=panelMuted, text_size=size.small)
    table.cell(riskTable, 0, 3, str.tostring(riskBudgetInput, "#.##") + " USD", bgcolor=panelAlt, text_color=panelText, text_size=size.small)
    table.cell(riskTable, 1, 3, "Risk", bgcolor=panelAlt, text_color=panelMuted, text_size=size.small)

alertcondition(longReadySignal, "SmartMoney-4 LONG ready", "SmartMoney-4 clean LONG setup ready")
alertcondition(shortReadySignal, "SmartMoney-4 SHORT ready", "SmartMoney-4 clean SHORT setup ready")

// Stable hidden fields consumed by Pine2Python proof generation.
plot(candidateDirection, "p2p_direction", display=display.none)
plot(candidateScore, "p2p_score", display=display.none)
plot(candidateEntry, "p2p_entry", display=display.none)
plot(candidateStop, "p2p_stop", display=display.none)
plot(candidateTarget, "p2p_target", display=display.none)
plot(candidatePoc, "p2p_poc", display=display.none)
plot(candidateHtf ? 1 : 0, "p2p_htf", display=display.none)
plot(candidateBos ? 1 : 0, "p2p_bos", display=display.none)
plot(candidateSweep ? 1 : 0, "p2p_sweep", display=display.none)
plot(candidateImbalance ? 1 : 0, "p2p_imbalance", display=display.none)
plot(candidatePocPass ? 1 : 0, "p2p_poc_pass", display=display.none)
plot(candidateFvgCount, "p2p_fvg_count", display=display.none)
plot(candidateFvgPassCount, "p2p_fvg_pass_count", display=display.none)
plot(candidateBreakFvg ? 1 : 0, "p2p_break_fvg", display=display.none)
plot(not na(candidateReadyBar) ? 1 : 0, "p2p_narrative_ready", display=display.none)
plot(candidateUpdatedSignal ? 1 : 0, "p2p_candidate_updated", display=display.none)
plot(setupReadySignal ? 1 : 0, "p2p_setup_ready", display=display.none)
plot(fillSignal ? 1 : 0, "p2p_fill", display=display.none)
plot(targetSignal ? 1 : 0, "p2p_target_hit", display=display.none)
plot(stopSignal ? 1 : 0, "p2p_stop_hit", display=display.none)
plot(ambiguousSignal ? 1 : 0, "p2p_ambiguous", display=display.none)

// === Pine2Python TradingView Parity Proof Dashboard v2 ===
p2p_start = input.time(1786181400000, "P2P proof start")
p2p_end = input.time(1787081400000, "P2P proof end")
p2p_mintick = input.float(0.01, "P2P expected minimum tick", minval=0.000000000001)
p2p_posmod(int value, int modulus) =>
    ((value % modulus) + modulus) % modulus
p2p_round(float value) =>
    int(math.floor(value + 0.500000001))
p2p_mix(int current, int value, int modulus, int multiplier, int tag) =>
    p2p_posmod(p2p_posmod(current * multiplier, modulus) + p2p_posmod(value, modulus) + tag * 17, modulus)
p2p_mix3(matrix<int> target, int row, int value, int tag) =>
    matrix.set(target, row, 0, p2p_mix(matrix.get(target, row, 0), value, 1000003, 257, tag))
    matrix.set(target, row, 1, p2p_mix(matrix.get(target, row, 1), value, 1000033, 263, tag))
    matrix.set(target, row, 2, p2p_mix(matrix.get(target, row, 2), value, 1000037, 269, tag))
p2p_init_hashes(int rows) =>
    result = matrix.new<int>(rows, 3, 0)
    for row = 0 to rows - 1
        matrix.set(result, row, 0, 17)
        matrix.set(result, row, 1, 19)
        matrix.set(result, row, 2, 23)
    result
p2p_triplet(int h1, int h2, int h3) =>
    str.tostring(h1, "0000000") + "-" + str.tostring(h2, "0000000") + "-" + str.tostring(h3, "0000000")
p2p_triplet_row(matrix<int> target, int row) =>
    p2p_triplet(matrix.get(target, row, 0), matrix.get(target, row, 1), matrix.get(target, row, 2))
p2p_cell(table target, int row, string label, string value) =>
    table.cell(target, 0, row, label, text_color=color.silver, text_halign=text.align_left)
    table.cell(target, 1, row, value, text_color=color.white, text_halign=text.align_right)
p2p_hash_data(matrix<int> p2p_hashes, int p2p_bar_count) =>
    int p2p_value = 0
    p2p_value := p2p_bar_count
    p2p_mix3(p2p_hashes, 0, p2p_value, 1)
    p2p_value := int(time / 1000)
    p2p_mix3(p2p_hashes, 0, p2p_value, 2)
    p2p_value := p2p_round(open / p2p_mintick)
    p2p_mix3(p2p_hashes, 0, p2p_value, 3)
    p2p_value := p2p_round(high / p2p_mintick)
    p2p_mix3(p2p_hashes, 0, p2p_value, 4)
    p2p_value := p2p_round(low / p2p_mintick)
    p2p_mix3(p2p_hashes, 0, p2p_value, 5)
    p2p_value := p2p_round(close / p2p_mintick)
    p2p_mix3(p2p_hashes, 0, p2p_value, 6)
    p2p_seg = 1 + math.min(7, math.max(0, int((time - p2p_start) * 8 / math.max(p2p_end - p2p_start, 1))))
    p2p_s1 = matrix.get(p2p_hashes, p2p_seg, 0)
    p2p_s2 = matrix.get(p2p_hashes, p2p_seg, 1)
    p2p_s3 = matrix.get(p2p_hashes, p2p_seg, 2)
    p2p_value := p2p_bar_count
    p2p_s1 := p2p_mix(p2p_s1, p2p_value, 1000003, 257, 1)
    p2p_s2 := p2p_mix(p2p_s2, p2p_value, 1000033, 263, 1)
    p2p_s3 := p2p_mix(p2p_s3, p2p_value, 1000037, 269, 1)
    p2p_value := int(time / 1000)
    p2p_s1 := p2p_mix(p2p_s1, p2p_value, 1000003, 257, 2)
    p2p_s2 := p2p_mix(p2p_s2, p2p_value, 1000033, 263, 2)
    p2p_s3 := p2p_mix(p2p_s3, p2p_value, 1000037, 269, 2)
    p2p_value := p2p_round(open / p2p_mintick)
    p2p_s1 := p2p_mix(p2p_s1, p2p_value, 1000003, 257, 3)
    p2p_s2 := p2p_mix(p2p_s2, p2p_value, 1000033, 263, 3)
    p2p_s3 := p2p_mix(p2p_s3, p2p_value, 1000037, 269, 3)
    p2p_value := p2p_round(high / p2p_mintick)
    p2p_s1 := p2p_mix(p2p_s1, p2p_value, 1000003, 257, 4)
    p2p_s2 := p2p_mix(p2p_s2, p2p_value, 1000033, 263, 4)
    p2p_s3 := p2p_mix(p2p_s3, p2p_value, 1000037, 269, 4)
    p2p_value := p2p_round(low / p2p_mintick)
    p2p_s1 := p2p_mix(p2p_s1, p2p_value, 1000003, 257, 5)
    p2p_s2 := p2p_mix(p2p_s2, p2p_value, 1000033, 263, 5)
    p2p_s3 := p2p_mix(p2p_s3, p2p_value, 1000037, 269, 5)
    p2p_value := p2p_round(close / p2p_mintick)
    p2p_s1 := p2p_mix(p2p_s1, p2p_value, 1000003, 257, 6)
    p2p_s2 := p2p_mix(p2p_s2, p2p_value, 1000033, 263, 6)
    p2p_s3 := p2p_mix(p2p_s3, p2p_value, 1000037, 269, 6)
    matrix.set(p2p_hashes, p2p_seg, 0, p2p_s1)
    matrix.set(p2p_hashes, p2p_seg, 1, p2p_s2)
    matrix.set(p2p_hashes, p2p_seg, 2, p2p_s3)
p2p_hash_features(matrix<int> p2p_hashes, int p2p_bar_count) =>
    int p2p_value = 0
    p2p_value := p2p_bar_count
    p2p_mix3(p2p_hashes, 9, p2p_value, 1)
    p2p_value := int(time / 1000)
    p2p_mix3(p2p_hashes, 9, p2p_value, 2)
    p2p_value := (na(candidateDirection) ? -2000000011 : p2p_round(candidateDirection))
    p2p_mix3(p2p_hashes, 9, p2p_value, 10)
    p2p_value := (na(candidateScore) ? -2000000011 : p2p_round(candidateScore))
    p2p_mix3(p2p_hashes, 9, p2p_value, 11)
    p2p_value := (na(candidateEntry) ? -2000000011 : p2p_round((candidateEntry) / p2p_mintick))
    p2p_mix3(p2p_hashes, 9, p2p_value, 12)
    p2p_value := (na(candidateStop) ? -2000000011 : p2p_round((candidateStop) / p2p_mintick))
    p2p_mix3(p2p_hashes, 9, p2p_value, 13)
    p2p_value := (na(candidateTarget) ? -2000000011 : p2p_round((candidateTarget) / p2p_mintick))
    p2p_mix3(p2p_hashes, 9, p2p_value, 14)
p2p_render_dashboard(table p2p_table, array<int> p2p_meta, matrix<int> p2p_hashes) =>
    p2p_cell(p2p_table, 0, "P2P PROOF", "basic_v1 / v2.12")
    p2p_cell(p2p_table, 1, "SOURCE", "f89ea6f3774a60b3")
    p2p_cell(p2p_table, 2, "SETTINGS", "22d38ef711dbe29c")
    p2p_cell(p2p_table, 3, "EXPECTED CONTEXT", "BINANCE:BTCUSDT / 15")
    p2p_cell(p2p_table, 4, "WINDOW", str.tostring(p2p_start) + ".." + str.tostring(p2p_end))
    p2p_cell(p2p_table, 5, "BARS", str.tostring(array.get(p2p_meta, 0)))
    p2p_cell(p2p_table, 6, "FIRST/LAST", str.tostring(array.get(p2p_meta, 1)) + "/" + str.tostring(array.get(p2p_meta, 2)))
    p2p_cell(p2p_table, 7, "DATA", p2p_triplet_row(p2p_hashes, 0))
    p2p_cell(p2p_table, 8, "MINTICK", str.tostring(p2p_mintick))
    p2p_cell(p2p_table, 9, "FEATURES", p2p_triplet_row(p2p_hashes, 9))
    p2p_cell(p2p_table, 10, "DATA SEG 1", p2p_triplet_row(p2p_hashes, 1))
    p2p_cell(p2p_table, 11, "DATA SEG 2", p2p_triplet_row(p2p_hashes, 2))
    p2p_cell(p2p_table, 12, "DATA SEG 3", p2p_triplet_row(p2p_hashes, 3))
    p2p_cell(p2p_table, 13, "DATA SEG 4", p2p_triplet_row(p2p_hashes, 4))
    p2p_cell(p2p_table, 14, "DATA SEG 5", p2p_triplet_row(p2p_hashes, 5))
    p2p_cell(p2p_table, 15, "DATA SEG 6", p2p_triplet_row(p2p_hashes, 6))
    p2p_cell(p2p_table, 16, "DATA SEG 7", p2p_triplet_row(p2p_hashes, 7))
    p2p_cell(p2p_table, 17, "DATA SEG 8", p2p_triplet_row(p2p_hashes, 8))
var p2p_meta = array.from(0, int(na), int(na))
var p2p_hashes = p2p_init_hashes(10)
p2p_in_window = time >= p2p_start and time < p2p_end
if p2p_in_window
    p2p_bar_count = array.get(p2p_meta, 0) + 1
    array.set(p2p_meta, 0, p2p_bar_count)
    array.set(p2p_meta, 1, na(array.get(p2p_meta, 1)) ? time : array.get(p2p_meta, 1))
    array.set(p2p_meta, 2, time)
    p2p_hash_data(p2p_hashes, p2p_bar_count)
    p2p_hash_features(p2p_hashes, p2p_bar_count)
var table p2p_table = table.new(position.bottom_right, 2, 18, bgcolor=color.new(color.black, 5), frame_color=color.gray, frame_width=1)
if barstate.islast
    p2p_render_dashboard(p2p_table, p2p_meta, p2p_hashes)
